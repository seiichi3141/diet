{
  "name": "diet-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "減量・体力増強プロジェクトの記録・可視化ツール",
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "fix:md": "markdownlint-cli2 --fix",
    "check": "npm run typecheck && npm run format:check && npm run lint:md && npm test",
    "log": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts log",
    "build": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts build",
    "summary": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts summary"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
